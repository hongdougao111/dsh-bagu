{
  "name": "dsh-bagu",
  "version": "0.9.0",
  "description": "给 AI 对外说话的一道门：像八股就打回。接梗走会话自己的模型，不用填 key。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "test",
    "data",
    "client.js",
    "dsh-plugin.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "license": "MIT",
  "author": {
    "name": "hongdougao111",
    "url": "https://github.com/hongdougao111"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hongdougao111/dsh-bagu.git"
  },
  "homepage": "https://github.com/hongdougao111/dsh-bagu#readme",
  "bugs": {
    "url": "https://github.com/hongdougao111/dsh-bagu/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "中文",
    "AI味",
    "八股",
    "写作",
    "commit",
    "review",
    "注释"
  ],
  "devDependencies": {
    "happy-dom": "^21.0.4"
  }
}
