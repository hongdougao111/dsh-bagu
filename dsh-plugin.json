    },
    "client": {
      "entry": "client.js",
      "platform": "web"
    }
  },
  "requires": {
    "contracts": [
      {
        "apiVersion": "tools.dsh/v1alpha1",
        "kind": "Tool"
      }
    ]
  },
  "permissions": [],
  "contributes": {
    "x-display": [
      {
        "title": "dsh-bagu",
        "description": "查一段话有多可替换：具体性、抽象度、留白、结构腔，带设置页，只给问句不自动改"
      }
    ]
